/*
  X-Content-Type-Options: nosniff

# theme.css/theme.js have no cache-busting hash in their filename (no build
# step generates one), so a 1-year immutable cache would strand visitors on a
# stale copy after the next edit. A 1-day cache still gives a strong repeat-visit
# win without that risk.
/theme.css
  Cache-Control: public, max-age=86400, must-revalidate

/theme.js
  Cache-Control: public, max-age=86400, must-revalidate

/*.jpg
  Cache-Control: public, max-age=2592000

/*.webp
  Cache-Control: public, max-age=2592000

/*.svg
  Cache-Control: public, max-age=2592000

/*.png
  Cache-Control: public, max-age=2592000

/*.html
  Cache-Control: public, max-age=0, must-revalidate
